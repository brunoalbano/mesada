# Copie para .env.local. Cada ambiente tem o seu conjunto completo.
# Ver docs/architecture.md seção 9.

# Públicas: chegam ao navegador. A proteção não é o segredo da chave, é a RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Nunca com prefixo NEXT_PUBLIC_, nunca no repositório.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC dos tokens de link e de convite. Precisa ser DIFERENTE entre
# desenvolvimento e produção: com o mesmo valor, um token gerado em
# desenvolvimento vale no banco de produção.
# Gere com: openssl rand -base64 48
TOKEN_PEPPER=
