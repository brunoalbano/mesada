# Copie para .env.local. Cada ambiente tem o seu conjunto completo.
# Ver docs/architecture.md seção 9.

# Públicas: chegam ao navegador. A proteção não é o segredo da chave, é a RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HMAC dos tokens de convite. Somente servidor: nunca com prefixo
# NEXT_PUBLIC_, nunca no repositório. Precisa ser DIFERENTE entre
# desenvolvimento e produção: com o mesmo valor, um convite gerado em
# desenvolvimento vale no banco de produção.
# Gere com: openssl rand -base64 48
TOKEN_PEPPER=

# A aplicação não usa service_role. Toda escrita passa pela RLS com o cliente
# do próprio usuário, e o que não cabe em policy tem função SECURITY DEFINER
# no banco.
